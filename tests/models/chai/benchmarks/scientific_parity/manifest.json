{
  "schema_version": 1,
  "claim_boundary": "Harness validation only; two diffusion timesteps are not production-quality inference.",
  "defaults": {
    "recycles": 1,
    "timesteps": 2,
    "samples": 1,
    "seed": 0,
    "esm": false
  },
  "entity_fixtures": [
    {
      "id": "protein",
      "fasta": "fixtures/protein.fasta",
      "entities": ["protein"]
    },
    {
      "id": "nucleic_acid",
      "fasta": "fixtures/nucleic_acid.fasta",
      "entities": ["rna", "dna"]
    },
    {
      "id": "protein_ligand",
      "fasta": "fixtures/protein_ligand.fasta",
      "entities": ["protein", "ligand"]
    },
    {
      "id": "modified_glycan_covalent",
      "fasta": "fixtures/modified_glycan_covalent.fasta",
      "restraint": "fixtures/modified_glycan_covalent.restraints",
      "entities": ["modified_protein", "ligand", "glycan"],
      "branches": {"covalent_bond": true}
    }
  ],
  "branch_sensitivity": [
    {
      "id": "baseline",
      "fixture": "protein",
      "branches": {"msa": false, "template": false, "restraint": false},
      "recycles": 1
    },
    {
      "id": "recycle_2",
      "fixture": "protein",
      "branches": {"msa": false, "template": false, "restraint": false},
      "recycles": 2
    },
    {
      "id": "restraint",
      "fixture": "protein",
      "restraint": "fixtures/protein.restraints",
      "branches": {"msa": false, "template": false, "restraint": true},
      "recycles": 1
    },
    {
      "id": "msa",
      "fixture": "protein",
      "required_external_asset": "matching upstream .aligned.pqt directory",
      "branches": {"msa": true, "template": false, "restraint": false},
      "recycles": 1
    },
    {
      "id": "template",
      "fixture": "protein",
      "required_external_asset": "matching m8 hits and template CIF directory",
      "branches": {"msa": false, "template": true, "restraint": false},
      "recycles": 1
    }
  ]
}
